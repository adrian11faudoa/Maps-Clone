{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/events/PlaceCreated.schema.json",
  "title": "PlaceCreated",
  "description": "Published by Places when a place is created (direct admin write or contribution approval apply).",
  "type": "object",
  "required": [
    "place_id",
    "name",
    "location",
    "categories",
    "status"
  ],
  "properties": {
    "place_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "name": {
      "type": "string"
    },
    "location": {
      "$ref": "common-defs.schema.json#/$defs/geoPoint"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "moderated_hidden"
      ]
    }
  },
  "additionalProperties": false
}
