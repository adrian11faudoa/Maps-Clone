{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/events/TileVersionPublished.schema.json",
  "title": "TileVersionPublished",
  "description": "Published by Map Tiles when a new TileSet/TileVersion is published to the CDN origin.",
  "type": "object",
  "required": [
    "tile_version_id",
    "version_number",
    "source_map_data_version_id"
  ],
  "properties": {
    "tile_version_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "version_number": {
      "type": "integer",
      "minimum": 1
    },
    "source_map_data_version_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    }
  },
  "additionalProperties": false
}
