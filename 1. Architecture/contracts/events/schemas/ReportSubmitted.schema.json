{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/events/ReportSubmitted.schema.json",
  "title": "ReportSubmitted",
  "description": "Published by Moderation & Administration when a user submits a report.",
  "type": "object",
  "required": [
    "report_id",
    "reporter_user_id",
    "subject_type",
    "subject_id"
  ],
  "properties": {
    "report_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "reporter_user_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "place",
        "review",
        "media",
        "contribution",
        "user"
      ]
    },
    "subject_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    }
  },
  "additionalProperties": false
}
