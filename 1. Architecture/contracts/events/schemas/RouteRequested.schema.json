{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/events/RouteRequested.schema.json",
  "title": "RouteRequested",
  "description": "Published by Routing when a route computation request is received.",
  "type": "object",
  "required": [
    "route_request_id",
    "mode",
    "origin",
    "destination"
  ],
  "properties": {
    "route_request_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "mode": {
      "type": "string",
      "enum": [
        "driving",
        "walking",
        "cycling",
        "transit"
      ]
    },
    "origin": {
      "$ref": "common-defs.schema.json#/$defs/geoPoint"
    },
    "destination": {
      "$ref": "common-defs.schema.json#/$defs/geoPoint"
    }
  },
  "additionalProperties": false
}
