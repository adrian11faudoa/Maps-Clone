{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/events/MediaProcessed.schema.json",
  "title": "MediaProcessed",
  "description": "Published by Media when derivative generation completes successfully.",
  "type": "object",
  "required": [
    "media_asset_id",
    "derivative_variants"
  ],
  "properties": {
    "media_asset_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "derivative_variants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
