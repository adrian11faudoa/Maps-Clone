{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/events/NavigationStarted.schema.json",
  "title": "NavigationStarted",
  "description": "Published by Navigation when a navigation session begins.",
  "type": "object",
  "required": [
    "session_id",
    "user_id",
    "route_id",
    "mode"
  ],
  "properties": {
    "session_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "user_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "route_id": {
      "$ref": "common-defs.schema.json#/$defs/ulid"
    },
    "mode": {
      "type": "string",
      "enum": [
        "driving",
        "walking",
        "cycling",
        "transit"
      ]
    }
  },
  "additionalProperties": false
}
