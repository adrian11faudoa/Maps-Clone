{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/entities/Rating.schema.json",
  "title": "Rating",
  "description": "The place-level aggregate rating summary derived from visible Reviews. Not independently mutable \u2014 recomputed whenever a contributing Review changes.",
  "type": "object",
  "x-owning-domain": "Reviews & Ratings (aggregate) / Places (stored as Place.rating_summary)",
  "x-authoritative-storage": "PostgreSQL places.place (rating_average, rating_count columns)",
  "x-privacy-classification": "public_place_data",
  "x-immutable-fields": [
    "place_id"
  ],
  "x-mutable-fields": [
    "average",
    "count",
    "recomputed_at"
  ],
  "x-deletion-semantics": "recomputed to zero-state if all contributing reviews are removed; the aggregate row itself is not separately deleted while the Place exists",
  "x-authorization": "See docs/architecture/08-auth-architecture.md resource-level table.",
  "required": [
    "place_id",
    "average",
    "count",
    "recomputed_at"
  ],
  "properties": {
    "place_id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "average": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "recomputed_at": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "x-relationships": {
    "belongs_to": [
      "Place"
    ]
  }
}
