{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/entities/SavedPlace.schema.json",
  "title": "SavedPlace",
  "description": "A user's saved reference to a Place, optionally within a SavedPlaceList.",
  "type": "object",
  "x-owning-domain": "Saved Places",
  "x-authoritative-storage": "PostgreSQL places.saved_place",
  "x-privacy-classification": "saved_places",
  "x-immutable-fields": [
    "id",
    "user_id",
    "place_id",
    "created_at"
  ],
  "x-mutable-fields": [
    "list_id",
    "label",
    "notes"
  ],
  "x-deletion-semantics": "hard-delete",
  "x-authorization": "Strictly owner-only.",
  "required": [
    "id",
    "user_id",
    "place_id",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "user_id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "place_id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "list_id": {
      "anyOf": [
        {
          "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
        },
        {
          "type": "null"
        }
      ]
    },
    "label": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "x-relationships": {
    "belongs_to": [
      "User",
      "Place",
      "SavedPlaceList"
    ]
  }
}
