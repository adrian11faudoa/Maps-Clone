{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/entities/Notification.schema.json",
  "title": "Notification",
  "description": "A durable in-app notification record, the record of what a user was told regardless of push/email outcome.",
  "type": "object",
  "x-owning-domain": "Notifications",
  "x-authoritative-storage": "PostgreSQL notifications.notification",
  "x-privacy-classification": "administrative_data",
  "x-immutable-fields": [
    "id",
    "user_id",
    "category",
    "title",
    "body",
    "created_at"
  ],
  "x-mutable-fields": [
    "read_at"
  ],
  "x-deletion-semantics": "hard-delete after a bounded retention window",
  "x-authorization": "Owner-only.",
  "required": [
    "id",
    "user_id",
    "category",
    "title",
    "body",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "user_id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "category": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read_at": {
      "anyOf": [
        {
          "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "x-relationships": {
    "belongs_to": [
      "User"
    ]
  }
}
