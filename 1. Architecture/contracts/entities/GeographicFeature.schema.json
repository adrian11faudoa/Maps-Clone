{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/entities/GeographicFeature.schema.json",
  "title": "GeographicFeature",
  "description": "Generic base-map geographic feature (administrative region, water body, land use area) \u2014 AdministrativeRegion is the specialized administrative-hierarchy case of this concept.",
  "type": "object",
  "x-owning-domain": "Geographic/Address Data",
  "x-authoritative-storage": "PostgreSQL/PostGIS geodata.administrative_region (and sibling feature tables)",
  "x-privacy-classification": "public_place_data",
  "x-immutable-fields": [
    "id",
    "map_data_version_id",
    "feature_type",
    "source",
    "created_at"
  ],
  "x-mutable-fields": [
    "name",
    "external_ids"
  ],
  "x-deletion-semantics": "hard-delete",
  "x-authorization": "See docs/architecture/08-auth-architecture.md resource-level table.",
  "required": [
    "id",
    "map_data_version_id",
    "name",
    "feature_type",
    "source",
    "created_at"
  ],
  "properties": {
    "id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "map_data_version_id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "name": {
      "type": "string"
    },
    "feature_type": {
      "type": "string",
      "enum": [
        "administrative_region",
        "water",
        "landuse"
      ]
    },
    "external_ids": {
      "type": "object"
    },
    "source": {
      "type": "string"
    },
    "created_at": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "x-relationships": {
    "belongs_to": [
      "MapDatasetVersion"
    ]
  }
}
