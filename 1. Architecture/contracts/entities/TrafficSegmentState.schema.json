{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.platform.internal/entities/TrafficSegmentState.schema.json",
  "title": "TrafficSegmentState",
  "description": "Aggregated traffic state for one road segment/time bucket. Referred to as TrafficSnapshot in Volume 1 docs \u2014 same entity.",
  "type": "object",
  "x-owning-domain": "Traffic",
  "x-authoritative-storage": "PostgreSQL/PostGIS traffic.traffic_snapshot (time-partitioned) + Redis hot cache",
  "x-privacy-classification": "aggregated_traffic",
  "x-immutable-fields": [
    "road_segment_id",
    "time_bucket",
    "created_at"
  ],
  "x-mutable-fields": [
    "congestion_level",
    "average_speed_mps",
    "confidence",
    "sample_count"
  ],
  "x-deletion-semantics": "rolling-window partition drop; never indefinite retention",
  "x-authorization": "See docs/architecture/08-auth-architecture.md resource-level table.",
  "required": [
    "road_segment_id",
    "time_bucket",
    "congestion_level",
    "confidence",
    "sample_count",
    "created_at"
  ],
  "properties": {
    "road_segment_id": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/ulid"
    },
    "time_bucket": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
    },
    "congestion_level": {
      "$ref": "../enums/registry.json#/enums/CongestionLevel/values"
    },
    "average_speed_mps": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sample_count": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "../events/schemas/common-defs.schema.json#/$defs/timestamp"
    }
  },
  "additionalProperties": false,
  "x-relationships": {
    "belongs_to": [
      "RoadSegment"
    ]
  }
}
